#IDebug {
    background-color: #F0F0F0; /* 设置背景色 */
}

QTabWidget::pane {
    border-top: 2px solid #C2C7CB;
    position: absolute;
    top: -0.5em;
}

QTabBar::tab {
    background-color: #F0F0F0;
    border: 1px solid #C4C4C3;
    border-bottom-color: #C2C7CB; /* same as the pane color */
    padding: 5px;
    min-width: 4px;
    font-size: 14px;
    font-weight: bold;
    color: #7F7F7F;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background-color: #C2C7CB;
    color: #000000;
    border-color: #9B9B9B;
}

/* QHBoxLayout {
    spacing: 10px; 
} */

QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #7F7F7F;
}

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #C4C4C3;
    padding: 6px;
    font-size: 14px;
}

QPushButton {
    background-color: #4CAF50;
    border: none;
    color: white;
    padding: 10px 24px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 14px;
    margin: 4px 2px;
    cursor: pointer;
}

